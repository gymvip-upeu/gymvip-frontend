# ==============================================================================
# GYM VIP (VIP CENTER FIT) — .gitignore para gymvip-frontend
# ==============================================================================

# 1. Dependencias y compilación de Node / Vite
node_modules/
dist/
dist-ssr/
*.local

# 2. Logs y reportes de ejecución
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 3. IDEs y editores de código
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 4. Secretos y variables de entorno privadas
.env
.env.*
!.env.example
!.env.*.example

# 5. Respaldos y volcados temporales
*.dump
*.backup
*.tmp

# 6. Documentación canónica: limitar docs/ al estado consolidado
/docs/*
!/docs/ESTADO_FRONTEND_SPRINT1.md
