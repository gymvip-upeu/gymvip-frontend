# ==============================================================================
# GYM VIP (VIP CENTER FIT) — CONFIGURACIÓN DE ENTORNO FRONTEND
# ==============================================================================
# NOTA: En Vite, solo las variables con prefijo VITE_ son expuestas al bundle.
# No coloque credenciales de base de datos ni secretos en este archivo.
# ==============================================================================

# URL base pública de la API de backend
# En desarrollo local: dejar vacío para consumir el proxy relativo de Vite (redirige a http://localhost:8081)
# En despliegue o conexión directa: http://localhost:8081 o https://gymvip-backend.onrender.com
VITE_API_BASE_URL=

# ==============================================================================
# SENTRY OBSERVABILIDAD Y MONITOREO
# ==============================================================================
# DSN del proyecto gymvip-frontend en Sentry
VITE_SENTRY_DSN=https://4640964826133bc59e4dacf55008f6a6@o4512046118797312.ingest.us.sentry.io/4512460658769920

# Entorno de ejecución: development | production | staging
VITE_SENTRY_ENVIRONMENT=development

# Identificador de Release para seguimiento de versiones y source maps
VITE_SENTRY_RELEASE=gymvip-frontend@1.0.0

# Muestreo de Performance Tracing (0.0 a 1.0)
VITE_SENTRY_TRACES_SAMPLE_RATE=0.2

# Muestreo de Session Replay (0.0 a 1.0)
VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1.0

# Token de autenticación para subir Source Maps en CI / Vercel Build (VARIABLE DE SISTEMA, NO EXPONER EN CLIENTE)
# SENTRY_AUTH_TOKEN=sntrys_...
